{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github/copilot-agent-runtime/repository-skill-forge/schemas.json",
  "title": "Repository Skill Forge artifact schemas",
  "$defs": {
    "extractionState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "scope",
        "runDir",
        "limits",
        "partitions",
        "retryHistory",
        "strategyHistory",
        "blockers",
        "omittedUnits",
        "handledActionIds",
        "workCounters",
        "coverage",
        "status"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "windowStart", "windowEnd"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "windowStart": { "type": "string" },
            "windowEnd": { "type": "string" }
          },
          "additionalProperties": false
        },
        "runDir": { "type": "string" },
        "limits": {
          "type": "object",
          "required": [
            "discoveryPageSize",
            "sessionBatchSize",
            "toolPageSize",
            "maxRows",
            "maxArtifactBytes",
            "minWindowMinutes",
            "maxConcurrentBatches",
            "maxQueryRetries",
            "allowPartial",
            "enableToolEventFallback"
          ],
          "properties": {
            "discoveryPageSize": { "type": "integer", "minimum": 1 },
            "sessionBatchSize": { "type": "integer", "minimum": 1 },
            "toolPageSize": { "type": "integer", "minimum": 1 },
            "maxRows": { "type": "integer", "minimum": 1 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1 },
            "minWindowMinutes": { "type": "integer", "minimum": 1 },
            "maxConcurrentBatches": { "type": "integer", "minimum": 1 },
            "maxQueryRetries": { "type": "integer", "minimum": 0 },
            "allowPartial": { "type": "boolean" },
            "enableToolEventFallback": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "partitions": { "type": "array", "items": { "type": "object" } },
        "retryHistory": { "type": "array", "items": { "type": "object" } },
        "strategyHistory": { "type": "array", "items": { "type": "object" } },
        "blockers": { "type": "array", "items": { "type": "object" } },
        "omittedUnits": { "type": "array", "items": { "type": "object" } },
        "issuedActions": { "type": "array", "items": { "type": "object" } },
        "handledActionIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workCounters": {
          "type": "object",
          "required": [
            "queryAttempts",
            "successfulQueries",
            "failedQueries",
            "rows",
            "toolCalls",
            "artifactBytes"
          ],
          "properties": {
            "queryAttempts": { "type": "integer", "minimum": 0 },
            "successfulQueries": { "type": "integer", "minimum": 0 },
            "failedQueries": { "type": "integer", "minimum": 0 },
            "rows": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "artifactBytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "coverage": { "type": ["object", "null"] },
        "status": { "enum": ["running", "complete", "partial", "blocked"] }
      },
      "additionalProperties": false
    },
    "workerWaveAction": {
      "type": "object",
      "description": "Exactly the arguments for one bounded session_store_sql call.",
      "required": ["actionId", "description", "kind", "query"],
      "properties": {
        "actionId": { "type": "string" },
        "description": {
          "type": "string",
          "description": "Equals actionId and must be passed to session_store_sql unchanged."
        },
        "kind": {
          "enum": ["discovery", "metadata", "refs", "files", "tool-calls"]
        },
        "rowLimit": { "type": ["integer", "null"], "minimum": 1 },
        "query": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workerProgress": {
      "type": "object",
      "description": "Bounded counters only: never session IDs, SQL, or result rows.",
      "required": [
        "status",
        "discoveryComplete",
        "discoveredSessionCount",
        "completedSessionCount",
        "batchCount",
        "batchesComplete",
        "omittedUnitCount",
        "blockerCount"
      ],
      "properties": {
        "status": { "enum": ["running", "complete", "partial", "blocked"] },
        "discoveryComplete": { "type": "boolean" },
        "partitionCount": { "type": "integer", "minimum": 0 },
        "discoveredSessionCount": { "type": "integer", "minimum": 0 },
        "completedSessionCount": { "type": "integer", "minimum": 0 },
        "omittedSessionCount": { "type": "integer", "minimum": 0 },
        "batchCount": { "type": "integer", "minimum": 0 },
        "batchesComplete": { "type": "integer", "minimum": 0 },
        "batchesOmitted": { "type": "integer", "minimum": 0 },
        "batchesPending": { "type": "integer", "minimum": 0 },
        "queryAttempts": { "type": "integer", "minimum": 0 },
        "successfulQueries": { "type": "integer", "minimum": 0 },
        "failedQueries": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "omittedUnitCount": { "type": "integer", "minimum": 0 },
        "omittedUnitKinds": { "type": "array", "items": { "type": "string" } },
        "blockerCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "workerRecordedOutcome": {
      "type": "object",
      "required": ["actionId", "outcome"],
      "properties": {
        "actionId": { "type": "string" },
        "outcome": {
          "enum": ["success", "query-failure", "handoff", "artifact", "pending"]
        },
        "rowCount": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "workerEnvelope": {
      "type": "object",
      "description": "The complete model-facing contract of extraction-worker.py.",
      "required": ["protocolVersion", "kind", "runId", "status", "progress"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "kind": { "enum": ["wave", "terminal", "status"] },
        "runId": { "type": "string" },
        "cycle": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["running", "complete", "partial", "blocked"] },
        "terminal": { "type": "boolean" },
        "recorded": {
          "type": "object",
          "required": ["counts", "actions"],
          "properties": {
            "counts": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "actions": {
              "type": "array",
              "items": { "$ref": "#/$defs/workerRecordedOutcome" }
            }
          },
          "additionalProperties": false
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "checkpointedBatchCount",
            "processedBatchCount",
            "terminalCoverageAttached",
            "failed"
          ],
          "properties": {
            "checkpointedBatchCount": { "type": "integer", "minimum": 0 },
            "processedBatchCount": { "type": "integer", "minimum": 0 },
            "terminalCoverageAttached": { "type": "boolean" },
            "failed": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "progress": { "$ref": "#/$defs/workerProgress" },
        "wave": {
          "type": "object",
          "required": ["manifestPath", "actionCount", "actions"],
          "properties": {
            "manifestPath": { "type": "string" },
            "actionCount": { "type": "integer", "minimum": 1 },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/workerWaveAction" }
            }
          },
          "additionalProperties": false
        },
        "next": {
          "type": "object",
          "required": ["tool", "callCount", "thenCommand"],
          "properties": {
            "tool": { "const": "session_store_sql" },
            "callCount": { "type": "integer", "minimum": 1 },
            "arguments": { "type": "string" },
            "thenCommand": { "type": "string" }
          },
          "additionalProperties": false
        },
        "coverage": { "type": "object" },
        "coveragePath": { "type": "string" },
        "omissionSummary": {
          "type": "object",
          "required": ["count", "kinds"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "kinds": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "blocker": {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "kind": { "type": ["string", "null"] },
            "errorKind": { "type": ["string", "null"] },
            "actionId": { "type": ["string", "null"] },
            "reason": { "type": "string", "maxLength": 400 }
          },
          "additionalProperties": false
        },
        "assertion": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "status": { "type": "string" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "pendingActionIds": { "type": "array", "items": { "type": "string" } },
        "ledgerPath": { "type": "string" },
        "statePath": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "wave" } } },
          "then": { "required": ["wave", "next", "cycle", "terminal"] }
        },
        {
          "if": { "properties": { "kind": { "const": "terminal" } } },
          "then": {
            "required": ["terminal", "ledgerPath"],
            "not": { "required": ["wave"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "normalizedSessionDocument": {
      "type": "object",
      "required": ["schemaVersion", "scope", "coverage", "userDiversity", "sessions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "windowStart", "windowEnd", "limitSessions"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "windowStart": { "type": "string" },
            "windowEnd": { "type": "string" },
            "limitSessions": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "coverage": { "type": "object" },
        "userDiversity": { "$ref": "#/$defs/userDiversity" },
        "sessions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "userDiversity": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sanitizedPrimitive": {
      "type": "object",
      "required": [
        "evidenceKey",
        "fingerprint",
        "kind",
        "sessionId",
        "surface",
        "outcome",
        "sourceContentRetained"
      ],
      "properties": {
        "evidenceKey": { "type": "string" },
        "fingerprint": { "type": "string" },
        "kind": { "enum": ["script", "command"] },
        "sessionId": { "type": "string" },
        "surface": { "enum": ["cli", "cca", "ccr"] },
        "branchId": { "type": ["string", "null"] },
        "branchCategory": { "enum": ["default", "other", "unknown"] },
        "completedAt": { "type": ["string", "null"] },
        "day": { "type": ["string", "null"] },
        "refs": { "type": "array", "items": { "type": "object" } },
        "pathFamilies": { "type": "array", "items": { "type": "string" } },
        "outcome": { "enum": ["success", "failure", "unknown"] },
        "exitCode": { "type": ["integer", "null"] },
        "signature": { "type": "object" },
        "commandTemplate": { "type": "string" },
        "sourceContentRetained": { "const": false }
      },
      "additionalProperties": true
    },
    "candidateDocument": {
      "type": "object",
      "required": [
        "schemaVersion",
        "scope",
        "thresholds",
        "userDiversity",
        "coverage",
        "usagePatterns",
        "candidates"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "asOf", "activeDays", "staleDays"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "asOf": { "type": "string" },
            "activeDays": { "type": "integer", "minimum": 1 },
            "staleDays": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "thresholds": { "type": "object" },
        "userDiversity": { "$ref": "#/$defs/userDiversity" },
        "coverage": { "type": "object" },
        "usagePatterns": { "type": "array", "items": { "type": "object" } },
        "candidates": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "proposalMetadata": {
      "type": "object",
      "required": ["proposalKey", "proposalVersion", "candidateIds", "decision"],
      "properties": {
        "proposalKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "proposalVersion": { "type": "string", "minLength": 1 },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": {
          "enum": [
            "create_skill",
            "improve_existing_skill",
            "merge_skills",
            "hold_as_pattern_only"
          ]
        }
      },
      "additionalProperties": false
    },
    "proposalCatalogEntry": {
      "type": "object",
      "required": [
        "proposalKey",
        "proposalVersion",
        "candidateIds",
        "decision",
        "number",
        "url",
        "status",
        "draft",
        "updatedAt"
      ],
      "properties": {
        "proposalKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "proposalVersion": { "type": "string", "minLength": 1 },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": {
          "enum": [
            "create_skill",
            "improve_existing_skill",
            "merge_skills",
            "hold_as_pattern_only"
          ]
        },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "status": { "enum": ["open", "closed", "merged"] },
        "draft": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
