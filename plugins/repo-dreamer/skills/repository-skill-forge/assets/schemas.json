{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github/copilot-agent-runtime/repository-skill-forge/schemas.json",
  "title": "Repository Skill Forge artifact schemas",
  "$defs": {
    "extractionState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "scope",
        "runDir",
        "limits",
        "partitions",
        "retryHistory",
        "strategyHistory",
        "blockers",
        "omittedUnits",
        "handledActionIds",
        "workCounters",
        "coverage",
        "status"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "windowStart", "windowEnd"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "windowStart": { "type": "string" },
            "windowEnd": { "type": "string" }
          },
          "additionalProperties": false
        },
        "runDir": { "type": "string" },
        "limits": {
          "type": "object",
          "required": [
            "discoveryPageSize",
            "sessionBatchSize",
            "toolPageSize",
            "maxRows",
            "maxArtifactBytes",
            "minWindowMinutes",
            "maxConcurrentBatches",
            "maxQueryRetries",
            "allowPartial",
            "enableToolEventFallback"
          ],
          "properties": {
            "discoveryPageSize": { "type": "integer", "minimum": 1 },
            "sessionBatchSize": { "type": "integer", "minimum": 1 },
            "toolPageSize": { "type": "integer", "minimum": 1 },
            "maxRows": { "type": "integer", "minimum": 1 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1 },
            "minWindowMinutes": { "type": "integer", "minimum": 1 },
            "maxConcurrentBatches": { "type": "integer", "minimum": 1 },
            "maxQueryRetries": { "type": "integer", "minimum": 0 },
            "allowPartial": { "type": "boolean" },
            "enableToolEventFallback": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "partitions": { "type": "array", "items": { "type": "object" } },
        "retryHistory": { "type": "array", "items": { "type": "object" } },
        "strategyHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "batchId", "sessionHash", "reason"],
            "properties": {
              "kind": { "const": "tool_events_fallback" },
              "batchId": { "type": "string" },
              "sessionHash": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "blockers": { "type": "array", "items": { "type": "object" } },
        "omittedUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionId": { "type": "string" },
              "kind": { "type": "string" },
              "partitionId": { "type": "string" },
              "batchId": { "type": "string" },
              "windowStart": { "type": "string" },
              "windowEnd": { "type": "string" },
              "sessionHashes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9a-f]{20}$" }
              },
              "reason": { "type": "string" }
            },
            "required": ["actionId", "kind", "partitionId", "reason"],
            "allOf": [
              {
                "if": {
                  "properties": { "kind": { "const": "discovery" } },
                  "required": ["kind"]
                },
                "then": {
                  "required": ["windowStart", "windowEnd"]
                },
                "else": {
                  "required": ["batchId", "sessionHashes"]
                }
              }
            ],
            "additionalProperties": false
          }
        },
        "handledActionIds": { "type": "array", "items": { "type": "string" } },
        "workCounters": {
          "type": "object",
          "required": ["queryAttempts", "successfulQueries", "failedQueries", "rows", "toolCalls", "artifactBytes"],
          "properties": {
            "queryAttempts": { "type": "integer", "minimum": 0 },
            "successfulQueries": { "type": "integer", "minimum": 0 },
            "failedQueries": { "type": "integer", "minimum": 0 },
            "rows": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "artifactBytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "coverage": { "type": ["object", "null"] },
        "status": { "enum": ["running", "complete", "partial", "blocked"] }
      },
      "additionalProperties": false
    },
    "normalizedSessionDocument": {
      "type": "object",
      "required": ["schemaVersion", "scope", "coverage", "userDiversity", "sessions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "windowStart", "windowEnd", "limitSessions"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "windowStart": { "type": "string" },
            "windowEnd": { "type": "string" },
            "limitSessions": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "coverage": { "type": "object" },
        "userDiversity": { "$ref": "#/$defs/userDiversity" },
        "sessions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "userDiversity": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sanitizedPrimitive": {
      "type": "object",
      "required": ["evidenceKey", "fingerprint", "kind", "sessionId", "surface", "outcome", "sourceContentRetained"],
      "properties": {
        "evidenceKey": { "type": "string" },
        "fingerprint": { "type": "string" },
        "kind": { "enum": ["script", "command"] },
        "sessionId": { "type": "string" },
        "surface": { "enum": ["cli", "cca", "ccr"] },
        "branchId": { "type": ["string", "null"] },
        "branchCategory": { "enum": ["default", "other", "unknown"] },
        "completedAt": { "type": ["string", "null"] },
        "day": { "type": ["string", "null"] },
        "refs": { "type": "array", "items": { "type": "object" } },
        "pathFamilies": { "type": "array", "items": { "type": "string" } },
        "outcome": { "enum": ["success", "failure", "unknown"] },
        "exitCode": { "type": ["integer", "null"] },
        "signature": { "type": "object" },
        "commandTemplate": { "type": "string" },
        "sourceContentRetained": { "const": false }
      },
      "additionalProperties": true
    },
    "candidateDocument": {
      "type": "object",
      "required": ["schemaVersion", "scope", "thresholds", "userDiversity", "coverage", "usagePatterns", "candidates"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository", "asOf", "activeDays", "staleDays"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" },
            "asOf": { "type": "string" },
            "activeDays": { "type": "integer", "minimum": 1 },
            "staleDays": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "thresholds": { "type": "object" },
        "userDiversity": { "$ref": "#/$defs/userDiversity" },
        "coverage": { "type": "object" },
        "usagePatterns": { "type": "array", "items": { "type": "object" } },
        "candidates": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "schemaVersion",
        "stateVersion",
        "scope",
        "cursor",
        "updatedAt",
        "observations",
        "proposalQueue",
        "proposalHistory"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "stateVersion": { "type": "integer", "minimum": 1 },
        "scope": {
          "type": "object",
          "required": ["kind", "repository"],
          "properties": {
            "kind": { "const": "repository" },
            "repository": { "type": "string" }
          },
          "additionalProperties": false
        },
        "cursor": { "type": ["string", "null"] },
        "updatedAt": { "type": "string" },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/compactObservation" }
        },
        "fingerprintCatalog": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[0-9a-f]{16}$" },
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "signatureVersion", "signature", "lastSeenAt"],
            "properties": {
              "kind": { "enum": ["command", "script"] },
              "signatureVersion": { "const": 1 },
              "signature": { "type": "object", "minProperties": 1 },
              "lastSeenAt": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "proposalQueue": {
          "type": "array",
          "items": { "$ref": "#/$defs/proposalQueueEntry" }
        },
        "proposalHistory": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/proposalHistoryEntry" }
        }
      },
      "additionalProperties": false
    },
    "compactObservation": {
      "type": "object",
      "required": [
        "evidenceKey",
        "fingerprint",
        "sessionHash",
        "completedAt",
        "day",
        "outcome",
        "surface",
        "kind",
        "branchHash",
        "branchCategory",
        "pathFamilies",
        "refs"
      ],
      "properties": {
        "evidenceKey": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "sessionHash": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
        "completedAt": { "type": ["string", "null"] },
        "day": { "type": ["string", "null"] },
        "outcome": { "enum": ["success", "failure", "unknown"] },
        "surface": { "enum": ["cli", "cca", "ccr"] },
        "kind": { "enum": ["script", "command"] },
        "branchHash": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{16,64}$" }]
        },
        "branchCategory": { "enum": ["default", "other", "unknown"] },
        "pathFamilies": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "refs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["pr", "issue", "commit"] },
              "value": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proposalQueueEntry": {
      "type": "object",
      "required": ["proposalKey", "candidateIds", "proposalVersion", "decision", "rank", "enqueuedAt"],
      "properties": {
        "proposalKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "proposalVersion": { "type": "string", "minLength": 1 },
        "decision": {
          "enum": ["create_skill", "improve_existing_skill", "merge_skills", "hold_as_pattern_only"]
        },
        "rank": { "type": "integer", "minimum": 0 },
        "enqueuedAt": { "type": "string" },
        "reconciliation": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["allowed", "reason", "action"],
              "properties": {
                "allowed": { "type": "boolean" },
                "reason": { "type": "string", "minLength": 1 },
                "action": { "enum": ["create", "update", "skip", "hold"] },
                "existingPrRef": { "type": "string" },
                "existingStatus": { "enum": ["open", "closed", "merged"] },
                "existingDraft": { "type": "boolean" },
                "nextAllowedAt": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "proposalHistoryEntry": {
      "type": "object",
      "required": [
        "proposalKey",
        "candidateIds",
        "proposalVersion",
        "decision",
        "status",
        "publishedAt",
        "prRef",
        "draft"
      ],
      "properties": {
        "proposalKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "proposalVersion": { "type": "string", "minLength": 1 },
        "decision": {
          "enum": ["create_skill", "improve_existing_skill", "merge_skills", "hold_as_pattern_only"]
        },
        "status": {
          "enum": ["open", "published", "closed", "merged", "rejected", "blocked", "held", "skipped"]
        },
        "publishedAt": { "type": "string" },
        "prRef": { "type": ["string", "null"] },
        "draft": { "type": "boolean" },
        "lastEvaluation": {
          "type": "object",
          "required": ["candidateIds", "proposalVersion", "decision", "status", "evaluatedAt"],
          "properties": {
            "candidateIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "proposalVersion": { "type": "string", "minLength": 1 },
            "decision": {
              "enum": ["create_skill", "improve_existing_skill", "merge_skills", "hold_as_pattern_only"]
            },
            "status": {
              "enum": ["open", "published", "closed", "merged", "rejected", "blocked", "held", "skipped"]
            },
            "evaluatedAt": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "legacyProposalHistoryEntry": {
      "type": "object",
      "required": ["candidateVersion", "decision", "status", "publishedAt", "prRef"],
      "properties": {
        "candidateVersion": { "type": "string", "minLength": 1 },
        "decision": {
          "enum": ["create_skill", "improve_existing_skill", "merge_skills", "hold_as_pattern_only"]
        },
        "status": {
          "enum": ["open", "published", "merged", "rejected", "blocked", "held"]
        },
        "publishedAt": { "type": "string" },
        "prRef": { "type": ["string", "null"] },
        "lastEvaluation": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
